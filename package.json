{
  "name": "minescape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A multiplayer sandbox game crossing RuneScape's skills and progression with Minecraft's voxel world. Built for 1-8 players.",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "three": "^0.164.0",
    "tsx": "^4.11.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/three": "^0.164.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
